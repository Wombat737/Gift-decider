# Copy to .env.local and fill in. The app runs in Explore demo if these are empty.
# Never commit .env.local — GitHub Pages has no secrets and must keep working.
#
# Vercel uses the same EXPO_PUBLIC_* names (Project Settings → Environment Variables).
# Set them for Production and Preview. Do not put real keys in git.
# Leave EXPO_BASE_URL unset on Vercel (root path). GitHub Pages CI sets /Gift-decider.

# --- Supabase (required to leave demo-only mode) ---
# Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# anon / publishable key — never put the secret/service-role key in the app
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Older local files may still use this alias; the app accepts either.
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: local Supabase CLI (`npx supabase start` then `npx supabase status`)
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Public web origin used when composing share links (EAS web, Expo web, or Vercel).
# On Vercel, set this to the production origin after the first deploy, then redeploy.
# Example: https://YOUR-APP.vercel.app  (no /Gift-decider subpath)
EXPO_PUBLIC_APP_URL=http://localhost:8081

# --- Auth placeholders (production OAuth is NOT wired in this scaffold) ---
# Flip these to "true" only after you finish Apple / Google + Supabase provider setup
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Google Cloud OAuth client IDs (placeholders until you create them)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional LLM (leave empty — dead-link heal and vibe copy use a deterministic stub)
# Prefer the heal-link / improv-substitutes Edge Functions in production; a public key in EXPO_PUBLIC_* is visible in the web bundle.
# EXPO_PUBLIC_OPENAI_API_KEY=
# EXPO_PUBLIC_LLM_URL=
# EXPO_PUBLIC_LLM_MODEL=gpt-4o-mini

# Soft launch (optional — stubs work without these)
# Hosted privacy page. Empty = in-app /privacy (GitHub Pages: /Gift-decider/privacy)
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://wombat737.github.io/Gift-decider/privacy
# Inbox for App Store / Play account-deletion requests (mailto stub)
# EXPO_PUBLIC_SUPPORT_EMAIL=hello@giftdecider.app
# Console analytics traces only. Leave false — no paid analytics account required
# EXPO_PUBLIC_ANALYTICS_ENABLED=false

# Optional: Edge Function notify-organiser-ready-to-buy (server secrets — not EXPO_PUBLIC).
# Demo never needs these; the giver UI shows the would-be email stub.
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# NOTIFY_FROM_EMAIL=Gift Decider <hello@giftdecider.app>
# Fallback recipient when the request has no organiser_email (function env, not EXPO_PUBLIC)
# NOTIFY_TO_EMAIL=

# Deep-link scheme is set in app.json (`giftdecider`). Magic-link redirect:
#   giftdecider://auth/callback
#   http://localhost:8081/auth/callback
#   https://YOUR-APP.vercel.app/auth/callback
# Add those URLs under Supabase → Authentication → URL Configuration → Redirect URLs.
