{
  "expo": {
    "name": "Gift Decider",
    "slug": "gift-decider",
    "owner": "wombats",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "giftdecider",
    "userInterfaceStyle": "light",
    "primaryColor": "#E85D4C",
    "backgroundColor": "#FAFAFA",
    "description": "Pick gifts from a living photo wishlist. Recipients pin photos and vibes; givers open a surprise-safe share link.",
    "githubUrl": "https://github.com/Wombat737/Gift-decider",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.giftdecider.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["giftdecider"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E85D4C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.giftdecider.app",
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "name": "Gift Decider",
      "shortName": "Gift Decider",
      "themeColor": "#E85D4C",
      "backgroundColor": "#FAFAFA"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gift Decider uses your photos so you can pin a gift picture.",
          "cameraPermission": "Gift Decider uses the camera so you can snap a gift picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["text/plain", "text/html", "image/*"],
            "multipleShareMimeTypes": ["text/plain", "image/*"]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAFA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d2cd72f5-20f3-42da-866d-c60b9dcd6b3e"
      }
    }
  }
}
